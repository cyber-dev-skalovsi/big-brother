[Unit]
Description=Big Brother Agent Service
Wants=network-online.target
After=network-online.target

[Service]
Environment="PORT=45876"
# Port number can be overridden in bigbrother-agent.conf if needed
EnvironmentFile=/etc/bigbrother-agent.conf
ExecStart=/usr/bin/bigbrother-agent
User=bigbrother
Restart=on-failure
StateDirectory=bigbrother-agent

# Security/sandboxing settings
KeyringMode=private
LockPersonality=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
